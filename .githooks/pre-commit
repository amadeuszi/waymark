#!/usr/bin/env bash
# Blocks commits that stage env files or look like they contain API keys.
set -euo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
bad=0
while IFS= read -r f; do
  case "$f" in
    .env.example) ;;
    .env|.env.*|*.pem|*.key) echo "pre-commit: refusing to commit secret file: $f" >&2; bad=1 ;;
  esac
done <<< "$staged"
pattern='(sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(api[_-]?key|secret|token|password)[\"'\'' ]*[:=][\"'\'' ]*[A-Za-z0-9_\-]{16,})'
if git diff --cached -U0 -- $staged | grep -E '^\+' | grep -Eiq "$pattern"; then
  echo "pre-commit: staged changes look like they contain a secret:" >&2
  git diff --cached -U0 -- $staged | grep -E '^\+' | grep -Eio "$pattern" | sed -E 's/(.{8}).*/\1…/' >&2
  bad=1
fi
[ "$bad" -eq 0 ] || { echo "Commit blocked. Remove the secret (use .env)." >&2; exit 1; }
